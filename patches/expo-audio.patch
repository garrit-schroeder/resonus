+
+  override fun getContentPosition(): Long = shifted(super.getContentPosition())
+
+  override fun getBufferedPosition(): Long = shifted(super.getBufferedPosition())
+
+  override fun getContentBufferedPosition(): Long = shifted(super.getContentBufferedPosition())
